{
  "repository": "${PROJECT_ROOT}",
  "package": "${FULL_TPO_PACKAGE}",
  "parent_config": "${FULL_TPO_RUNTIME}",
  "deployment": "${FULL_TPO_DEPLOYMENT}",
  "source_patterns": [
    "src/multimodal_jev/*.py",
    "tools/reports/*.py",
    "tools/jev/*.py"
  ],
  "io_workers": 8,
  "full_joint": {
    "design": "configs/experiments/tpo-single-stage-model-design-v1.json",
    "initial": "${FULL_TPO_INITIAL}",
    "initial_result_sha256": "${FULL_TPO_INITIAL_RESULT_SHA}",
    "initial_terminal_sha256": "${FULL_TPO_INITIAL_TERMINAL_SHA}",
    "initial_config_sha256": "${FULL_TPO_INITIAL_CONFIG_SHA}",
    "runtime_sha256": "${FULL_TPO_RUNTIME_SHA}",
    "input_identity_publication": "${FULL_TPO_INPUT_IDENTITIES}",
    "input_identity_sha256": "${FULL_TPO_INPUT_IDENTITIES_SHA}",
    "design_sha256": "${FULL_TPO_DESIGN_SHA}",
    "training_devices": "${FULL_TPO_TRAINING_DEVICES}",
    "inference_devices": "${FULL_TPO_INFERENCE_DEVICES}"
  },
  "custody": "${FULL_TPO_CUSTODY_CONFIG}"
}
