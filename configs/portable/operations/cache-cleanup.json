{
  "schema": "local-cache-cleanup-v1",
  "roots": "${CLEANUP_ROOTS}",
  "protected_paths": "${CLEANUP_PROTECTED_PATHS}",
  "pin_manifests": "${CLEANUP_PIN_MANIFESTS}",
  "min_age_seconds": 172800,
  "max_files": 10000,
  "max_bytes": 1073741824,
  "lock_path": "${CLEANUP_LOCK}",
  "output_directory": "${CLEANUP_OUTPUT}"
}
