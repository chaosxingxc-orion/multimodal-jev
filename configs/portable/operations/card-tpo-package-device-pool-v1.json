{
  "repository": "${PROJECT_ROOT}",
  "package": "${CARD_TPO_ROOT}/package",
  "targets": "${CARD_TPO_ROOT}/targets",
  "parent_config": "${CARD_TPO_PARENT}",
  "deployment": "${CARD_TPO_DEPLOYMENT}",
  "card_input": {
    "inference_devices": "${CARD_STAGE2_INFERENCE_DEVICES}",
    "inference_cpus": 12,
    "endpoint_receipt": "${CARD_ENDPOINT_AUDIT}"
  },
  "io_workers": 8,
  "source_patterns": [
    "src/multimodal_jev/*.py",
    "tools/reports/*.py",
    "tools/jev/*.py"
  ],
  "freeze_committed_repository": true
}
