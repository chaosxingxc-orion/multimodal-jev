{
  "repository": "${PROJECT_ROOT}",
  "package": "${TPO_PACKAGE}",
  "parent_config": "${TPO_PARENT_CONFIG}",
  "deployment": "${TPO_DEPLOYMENT}",
  "io_workers": 8,
  "source_patterns": [
    "src/multimodal_jev/*.py",
    "tools/reports/*.py",
    "tools/jev/*.py"
  ],
  "training_ops": "${TPO_TRAIN_OPS}",
  "training_operations_local": "${TPO_TRAIN_OPS_LOCAL}",
  "batch": 8,
  "stage1_step": 160,
  "eval_container": {
    "cpus": 6,
    "memory": "32g",
    "shm": "2g"
  },
  "datasets": "${TPO_EVAL_DATASETS}",
  "evaluation_cache_reuse": {
    "catalog": "configs/portable/operations/native-evaluation-cache-catalog-v1.json",
    "catalog_host": "${TPO_EVALUATION_CACHE_CATALOG_HOST}",
    "catalog_root": "${EXPERIMENT_TARGET_HOT_ROOT}",
    "catalog_seal_root": "${SHARED_ROOT}",
    "store": "${TPO_EVALUATION_CACHE_STORE}",
    "build": {
      "prefetch": 16,
      "progress_interval": 128
    }
  },
  "cache_container": {
    "cpus": 8,
    "memory": "16g",
    "shm": "2g"
  }
}
