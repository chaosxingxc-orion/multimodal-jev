{
  "repository": "${PROJECT_ROOT}",
  "package": "${TPO_PACKAGE}",
  "targets": "${TPO_TARGET_OUTPUT}",
  "parent_config": "${TPO_PARENT_CONFIG}",
  "deployment": "${TPO_DEPLOYMENT}",
  "io_workers": 8,
  "source_patterns": ["src/multimodal_jev/*.py", "tools/reports/*.py", "tools/jev/*.py"],
  "joint": {"design": "configs/experiments/tpo-joint-top1-v1.json", "native_reference": "${TPO_REFERENCE}", "control_root": "${TPO_CONTROL_ROOT}", "control_receipt": "${TPO_CONTROL_RECEIPT}", "inference_devices": "${TPO_INFERENCE_DEVICES}"}
}
