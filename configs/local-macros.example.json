{
  "schema": "jev-local-macros-v1",
  "macros": {
    "TRAJECTORY_PIPELINE_OUTPUT": "${RUNS_ROOT}/operations/trajectory-pipeline-v1",
    "WORKSPACE": "/absolute/path/to/multimodal-jev",
    "SHARED_ROOT": "/absolute/path/to/shared-assets",
    "DATASETS_ROOT": "${SHARED_ROOT}/datasets",
    "MODELS_ROOT": "${SHARED_ROOT}/models",
    "RUNS_ROOT": "/absolute/path/to/local-runs",
    "TRAIN_HOST": "your-ssh-alias",
    "TRAIN_DEVICES": [
      4,
      5,
      6,
      7
    ],
    "ASR_MODEL": "${MODELS_ROOT}/Qwen__Qwen3-ASR-0.6B-hf",
    "SLURP_RELEASE": "${DATASETS_ROOT}/slurp-jev-benchmark/official-clean-intent-v1",
    "SIGNAL_STEP": 512,
    "SIGNAL_PROOF": "${WORKSPACE}/docs/engineering/your-checkpoint-proof.json",
    "SIGNAL_PROOF_SHA256": "replace-with-proof-sha256",
    "SIGNAL_COLLECTION": "${RUNS_ROOT}/checkpoint-collection",
    "SIGNAL_SCHEDULE": "${RUNS_ROOT}/learning-schedule",
    "SIGNAL_RECEIPTS": "${RUNS_ROOT}/cache/independent.jsonl",
    "SIGNAL_CACHE_PROOF": "${WORKSPACE}/docs/engineering/your-cache-proof.json",
    "SIGNAL_OUTPUT": "${RUNS_ROOT}/reports/signal-v1",
    "SIGNAL_PUBLICATION": "${SIGNAL_OUTPUT}/COMPLETE.json",
    "SIGNAL_PUBLICATION_SHA256": "replace-with-upstream-publication-sha256",
    "PROBABILITY_ERRORS_OUTPUT": "${RUNS_ROOT}/reports/probability-errors-v1",
    "SLURP_TASKS": "${SLURP_RELEASE}/tasks.json",
    "BASE_ID": "replace-with-verified-binding",
    "TRAIN_SCHEDULE": "${TRAIN_ROOT}/source/schedule",
    "TRAIN_SCHEDULE_SHA256": "replace-with-verified-binding",
    "ENCODED_AUDIO_CACHE": "${TRAIN_ROOT}/encoded-audio-cache",
    "INITIAL_POLICY": "${TRAIN_ROOT}/initial/policy",
    "INITIAL_POLICY_ID": "replace-with-verified-binding",
    "INITIAL_POLICY_CONTRACT": {},
    "REFERENCE_CACHE": "${TRAIN_ROOT}/reference-cache",
    "ENGINE_EXCHANGE": "/jev-exchange",
    "ENGINE_SOCKET": "${ENGINE_EXCHANGE}/engine.sock",
    "INITIAL_ADAPTER": "${TRAIN_ROOT}/initial/adapter",
    "TRAIN_SOURCE_PINS": {},
    "AUDIO_MIRROR_ROOT": "${TRAIN_ROOT}/audio-mirror",
    "FORMAL_RELEASE": "${TRAIN_ROOT}/RELEASE.json",
    "FORMAL_RELEASE_SHA256": "replace-with-verified-binding",
    "TRAINING_DISPATCH_ALLOWED": false,
    "TRAIN_ROOT": "/absolute/path/on-training-host",
    "INFERENCE_DEVICES": [],
    "INFERENCE_DEVICE_SCOPE": {},
    "CLEANUP_ROOTS": [
      "${WORKSPACE}/src",
      "${WORKSPACE}/tools",
      "${WORKSPACE}/tests"
    ],
    "CLEANUP_PROTECTED_PATHS": [
      "${WORKSPACE}/.local",
      "${WORKSPACE}/configs",
      "${WORKSPACE}/docs"
    ],
    "CLEANUP_PIN_MANIFESTS": [],
    "CLEANUP_LOCK": "${RUNS_ROOT}/operations/cache-cleanup.lock",
    "CLEANUP_OUTPUT": "${RUNS_ROOT}/operations/cache-cleanup-plan-v1",
    "SCHEDULE_INPUT_LEDGER": "${RUNS_ROOT}/processor/inputs.jsonl",
    "SCHEDULE_INPUT_LEDGER_SHA256": "replace-with-verified-ledger-sha256",
    "SCHEDULE_OUTPUT": "${RUNS_ROOT}/operations/full-training-schedule-v1",
    "OPERATIONS_OUTPUT": "${RUNS_ROOT}/operations/prepare-training-configs-v1",
    "REPORT_PIPELINE_OUTPUT": "${RUNS_ROOT}/operations/report-pipeline-v1",
    "TRAJECTORY_COLLECTION": "${RUNS_ROOT}/training-collected",
    "TRAJECTORY_TRANSPORT": "${TRAJECTORY_COLLECTION}.transport.json",
    "TRAJECTORY_TRANSPORT_SHA256": "replace-with-verified-transport-sha256",
    "TRAJECTORY_OUTPUT": "${RUNS_ROOT}/operations/trajectory-v1",
    "TRAIN_IMAGE": "sha256:52ba94e1b6ba35f09066a92222f013ce9563fdbd83a6a5e7a60d209ac29f756c",
    "TRAIN_MOUNT_SOURCE_CONTAINER": "replace-with-exited-verified-container-id",
    "ASCEND_DRIVER_ROOT": "/absolute/path/to/Ascend/driver"
  }
}
