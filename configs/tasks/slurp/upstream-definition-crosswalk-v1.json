    {
      "paragraphs": [
        7,
        9,
        44
      ],
      "principle": "Annotate user goal and key information relevant to fulfilling that goal; not an exhaustive all-mention ontology."
    },
    {
      "paragraphs": [
        57,
        59,
        61
      ],
      "principle": "Correct preassigned scenario and intent when the utterance expresses a different goal."
    },
    {
      "paragraphs": [
        48,
        50,
        51
      ],
      "principle": "Entity types can be introduced and reused across utterances/scenarios; historical inventory is not immutable."
    },
    {
      "paragraphs": [
        106,
        108,
        110
      ],
      "principle": "Some utterances have no entity under this annotation scheme; does not certify every empty current set."
    },
    {
      "paragraphs": [
        126
      ],
      "principle": "Native intent identity combines scenario and action."
    }
  ],
  "unresolved_rules": [
    "No complete exclusive priority for multi-goal or conditional requests.",
    "No exhaustive negative semantics for our full-utterance S_present.",
    "Historical type names and examples are not a certified mapping to the final SLURP ontology.",
