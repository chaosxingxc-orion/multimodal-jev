{
  "protocol": "slurp-jev-transfer-v1",
  "heldout_scenarios": ["calendar", "email", "transport"],
  "slot_types": ["date", "time", "person", "place_name"],
  "variants": ["native", "permutation", "rebind"],
  "duplicate_text_policy": "exclude-train-texts-present-in-valid-or-test",
