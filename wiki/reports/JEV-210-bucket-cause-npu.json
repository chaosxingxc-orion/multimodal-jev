   assert list(phases)==['tower','language','head_end','loss','backward'],list(phases)\n+            edges=[t,*phases.values(),t+seconds]\n+            parts=dict(zip([*phases,'optimizer'],[b-a for a,b in zip(edges,edges[1:])]))\n+            digest=hashlib.sha256(logits.detach().float().cpu().contiguous().numpy().tobytes()).hexdigest()\n+            print('PHASE '+json.dumps(dict(case=case,mode=mode,width=width,i=i,seconds=seconds,parts=parts,logits_sha256=digest,loss=loss.item(),norm=norm.item())),flush=True)\n             if not torch.isfinite(loss).item() or not torch.isfinite(norm).item():raise ValueError('nonfinite update')\n             print('update',i,round(seconds,3),flush=True)\n             if i>=config['warmup']:times.append(dict(seconds=seconds,allocated=torch.npu.max_memory_allocated(),\n--- a/src/multimodal_jev/span_packed_attention.py\n+++ b/attention/span_packed_attention.py\n@@ -49,7 +49,7 @@\n         kernel = npu_flash_attn_varlen_func\n     if card_groups.active():\n         return card_groups.grouped(query, key, value, lengths, scaling, kernel)\n-    packed = [torch.cat([t[i, :, :n].transpose(0, 1) for i, n in enumerate(lengths)], 0)\n+    packed = [torch.cat([row[:, :n].transpose(0, 1) for row, n in zip(t.unbind(0),lengths,strict=True)], 0)\n               for t in (query, key, value)]\n     cumulative = torch.tensor([0, *lengths], dtype=torch.int32).cumsum(0, dtype=torch.int32)\n     output = kernel(*packed, cumulative, cumulative, max_seqlen_q=max(lengths),\n--- a/src/multimodal_jev/context_row_head.py\n+++ b/head/context_row_head.py\n@@ -15,8 +15,8 @@\n         head._validate(hidden, positions, valid)\n         if not torch.equal(valid, valid.long().cumprod(-1).bool()):\n             raise ValueError('row readout requires right padding')\n-        return torch.cat([original(hidden[i:i+1, :n], positions[i:i+1], valid[i:i+1, :n])\n-                          for i,n in enumerate(valid.sum(-1).tolist())])\n+        return torch.cat([original(r